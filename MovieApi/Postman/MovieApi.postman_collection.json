    {
      "name": "Senario - Movie Lifecycle",
      "item": [
        {
          "name": "01 - Get All Movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Every movie has required properties\", function () {\r\n    const movies = pm.response.json();\r\n\r\n    movies.forEach(movie => {\r\n        pm.expect(movie).to.have.property(\"id\");\r\n        pm.expect(movie).to.have.property(\"title\");\r\n        pm.expect(movie).to.have.property(\"director\");\r\n        pm.expect(movie).to.have.property(\"releaseYear\");\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{Base_URL}}/api/movies",
              "host": [
                "{{Base_URL}}"
              ],
              "path": [
                "api",
                "movies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Create Test Movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response contains created movie\", function () {\n    const movie = pm.response.json();\n\n    pm.expect(movie.title).to.eql(\"Postman Test Movie\");\n    pm.expect(movie.director).to.eql(\"Test Director\");\n    pm.expect(movie.releaseYear).to.eql(2020);\n    pm.expect(movie.id).to.be.a(\"number\");\n});\n\npm.test(\"Location header exists\", function () {\n    pm.expect(\n        pm.response.headers.has(\"Location\")\n    ).to.be.true;\n});\n\nif (pm.response.code === 201) {\n    const movie = pm.response.json();\n\n    if (Number.isInteger(movie.id) && movie.id > 0) {\n        pm.environment.set(\"movieId\", movie.id);\n    }\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Postman Test Movie\",\n    \"director\": \"Test Director\",\n    \"releaseYear\": 2020 \n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Base_URL}}/api/movies",
              "host": [
                "{{Base_URL}}"
              ],
              "path": [
                "api",
                "movies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 - Get Created Movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Correct movie was returned\", function () {\n    const movie = pm.response.json();\n\n    const expectedId =\n        Number(pm.environment.get(\"movieId\"));\n\n    pm.expect(movie.id).to.eql(expectedId);\n    pm.expect(movie.title).to.eql(\"Postman Test Movie\");\n    pm.expect(movie.releaseYear).to.eql(2020);\n});"
                ]
              }
            }
          ],
